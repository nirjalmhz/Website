rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if request is from the owner of the document or resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if user is admin based on email
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "69nirjalmaharjan@gmail.com";
    }

    // Users Collection: Only owner or admin can read/write
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    // Favorites Collection: Scoped to owner or admin
    match /favorites/{favoriteId} {
      allow read, write: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // History Collection: Scoped to owner or admin
    match /history/{historyId} {
      allow read, write: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Preferences Collection: Scoped to owner or admin
    match /preferences/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // System Alerts Collection: Anyone can read, only admin can write
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
